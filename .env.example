# ==============================================================================
# NexFleet Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env or .env.local to configure your local development
# or production deployment.
#
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Settings
# ------------------------------------------------------------------------------
APP_NAME=NexFleet
APP_ENV=development
PORT=3000
DEBUG=false

# ------------------------------------------------------------------------------
# 2. Next.js Frontend Configuration
# ------------------------------------------------------------------------------
# Public application URL for web client metadata and OpenGraph
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public branding display title
NEXT_PUBLIC_APP_NAME="NexFleet — Compliance & Regulatory Risk Atlas"

# Relative path or CDN URL to precomputed multi-scenario decision tree JSON
NEXT_PUBLIC_DEMO_DATA_PATH=/demo_data.json

# Default initial carbon tax slider point in USD/tCO2e ($0 - $1,000)
NEXT_PUBLIC_DEFAULT_CARBON_PRICE=100

# Map tile configuration (OpenStreetMap dark theme tile provider)
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
NEXT_PUBLIC_MAP_ATTRIBUTION="&copy; OpenStreetMap contributors &copy; CARTO"

# ------------------------------------------------------------------------------
# 3. Python Optimization & Quantum-Inspired Engine (NexFleet Core)
# ------------------------------------------------------------------------------
# Python module search path
PYTHONPATH=./src:.

# Active optimizer metaheuristic: 'ga' (Genetic Algorithm) or 'qiea' (Quantum-Inspired)
NEXFLEET_OPTIMIZER=ga

# Fast execution mode (1 = fast dev iteration, 0 = production convergence)
NEXFLEET_FAST_MODE=0

# Evolutionary solver population & generation budgets
NEXFLEET_POPULATION_SIZE=200
NEXFLEET_COLD_GENERATIONS=200
NEXFLEET_WARM_GENERATIONS=12

# Random seeds for multi-scenario flip-counting and stability exposure analysis
NEXFLEET_EXPOSURE_SEEDS=0,1,2

# ------------------------------------------------------------------------------
# 4. Carbon Price Sweep Grid Parameters
# ------------------------------------------------------------------------------
# Price sweep bounds in USD/tCO2e
NEXFLEET_SWEEP_MIN_PRICE=0
NEXFLEET_SWEEP_MAX_PRICE=1000
NEXFLEET_SWEEP_STEP=25

# ------------------------------------------------------------------------------
# 5. Pipeline Artifact Destinations
# ------------------------------------------------------------------------------
# Output path for decision matrix generation
NEXFLEET_OUTPUT_PATH=outputs/demo_data.json

# Synced frontend public asset destination
NEXFLEET_FRONTEND_DATA_PATH=frontend/public/demo_data.json

# ------------------------------------------------------------------------------
# 6. Financial & Currency Parameters
# ------------------------------------------------------------------------------
# USD to INR conversion rate for Capex and Plan Spread reporting
DEFAULT_USD_TO_INR_RATE=95.60
